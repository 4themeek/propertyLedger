# Neon Postgres pooled connection string (Neon dashboard -> Connect)
DATABASE_URL=

# Output of `npm run hash:password -- "your password"` — never store the plaintext password
APP_PASSWORD_HASH=

# Output of `openssl rand -hex 32` — signs the session cookie
SESSION_SECRET=

# Cloudflare R2 (dashboard -> R2 -> Manage API tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=property-ledger-files
